entry: Prūsa
  id: Prūsa
  pos: noun
  gender: fem
  paradigm: 45
  label: DK
  label: VM
  pronunciation:
    soundFile: https://wirdeins.twanksta.org/upload/audio/prusa.mp3
    label: deadAudio
  sense:
    en: Baltic Prussia (Prussia without Brandenburgand Pommerania)
    de: Prußenland
    de: Frisching(?)
    lt: Prūsa
    lv: Prūsa (baltiskā Prūsija)
    pl: Prusy
    ru: Пруссия (Балтийская, без Бранденбурга и Поммерании)
    ru: Пруса
  inflectedForm: Prūsa
    tag: sg.nom
  inflectedForm: Prūsas
    tag: pl.nom
  inflectedForm: Prūsas
    tag: sg.gen
  inflectedForm: Prūsan
    tag: pl.gen
