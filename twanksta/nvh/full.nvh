    lv: krīvs
    pl: kriwis
    pl: wajdelota
    ru: жрец прусский
  inflectedForm: kriwwis
    tag: sg.nom
  inflectedForm: kriwwjai
    tag: pl.nom
  inflectedForm: kriwwjas
    tag: sg.gen
  inflectedForm: kriwwjan
