entry: āngs
  id: āngs
  pos: noun
  gender: fem
  paradigm: 60
  label: E
  pronunciation:
    soundFile: https://wirdeins.twanksta.org/upload/audio/angs.mp3
    label: deadAudio
  sense:
    en: snake
    de: Schlange (Reptil)
    lt: gyvatė
    lv: čūska
    pl: żmija
    ru: змея
  inflectedForm: āngs
    tag: sg.nom
  inflectedForm: āngis
    tag: pl.nom
  inflectedForm: āngis
    tag: sg.gen
  inflectedForm: āngin
    tag: pl.gen
  inflectedForm: āngei
    tag: sg.dat
  inflectedForm: angimmans
    tag: pl.dat
  inflectedForm: āngin
    tag: sg.acc
  inflectedForm: āngins
    tag: pl.acc
  legacy:
    desc: f [Angis E 747]
    article: <p><a href="#angs">Āngis</a> ast swentan be zmānintan, sklāitewingi sta ast ezze <a href="#angzdris">angzdrjans</a>. Ezze stan tūlan peisāi <strong>M. Prātorjan</strong> (XVII mm.), pastippan ezze stan mazīngi skaitātun <a href="http://awizi.twanksta.org/etnografija/zmaninsna-steisan-angin/">stwi</a>:</p>\n<blockquote>\n<p>Ānkstais wārai prūsai laikāi aulemtans āngins per swentans be sklāitewingjai zmānina tennans</p>\n<p>[...]</p>\n<p>Adder tikslan kasse paggan prūsai tēr spārtai pawērtina āngins, sklāit dwigubāsnan, bēi en stawīdamans retawīngjamans prēipaljans, kāigi māise, ānkstais gērbts pra Dīwuljan, gērbsenis ezze āngin ligzdan en Labjawai, en stawīdamans prēipaljamans  zmānes minijja ezze sta be kittan. Prūsai mēriwusis, kāi arwiskai prawerēi nadirītwei kīrsa subbans āngins. Kāigi mennei izgūbi kirdītun ezze aīnasmu zemāitju, sen kawīdan bilīwuns en Wīšwilei, en Rangānis skrittei, en Skallawai, tenēi zmānina āngins, be stwi kasse paggan: Āngin dēiws, bilīwuns tāns, dāi angimmans stan, ka ni dāi kitēimans zwerimmans, — sklāits wisawīdiskans ōrganans izwinandau, tenā mazzi tēt dīwai repītwei be prēipaus bīgtwei kāigi tēr mazzi kitāi zwerrjai sen swāise plāugzdans, skreīljans be naggins, tēr en angimmans turri sargātun si nijāukus āustabawingis (pa tenēisan wīrdans — dēiwisks) naseīlis, kawīds tennan gunna. Āngis subbas ni aulaūja, ik tēr ni wīrst būwus tēt, kāi tennas pastānja galīntan anga kitāi zwērjai galīna tennans, beggi eraīnan mettan tennas wis pastānja māldas, ebwēlkantjai anga auwēlkantjai wāran kjaūtan.</p>\n</blockquote>
