entry: Pergrubris
  id: Pergrubris
  pos: noun
  gender: masc
  paradigm: 40
  label: GlN
  pronunciation:
    soundFile: https://wirdeins.twanksta.org/upload/audio/pergrubris.mp3
    label: deadAudio
  sense:
    en: Pergrubrius
    de: Pergrubrius
    lt: Pergrubrius
    lv: Pergrubrius
    pl: Pergrubrius
    ru: Пергрубрюс
  inflectedForm: Pergrubris
    tag: sg.nom
