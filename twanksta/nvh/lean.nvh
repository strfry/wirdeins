entry: pikuls
  id: pikuls-1
  homograph: 1
  pos: noun
  gender: masc
  paradigm: 32
  pronunciation:
    soundFile: https://wirdeins.twanksta.org/upload/audio/pikuls.mp3
    label: deadAudio
  sense:
    en: devil
    de: Teufel
    lt: velnias
    lv: velns
    pl: diabeł
    ru: дьявол
    ru: черт
  inflectedForm: pikullamans
    tag: pl.dat
  inflectedForm: pikullas
    tag: sg.gen
  legacy:
    desc: [Pickūls 55]
    article: <p><b><a href="#pikuls">Pikuls</a></b> pa <em><a href="http://awizi.twanksta.org/etnografija/sudawisks-laiskiks/">Sūdawiskan lāiskikan</a>,</em> ast pikullas be timras dēiws, stwen pat ast dīgi <strong>Pōkuls</strong> (Pockols) — skraidāntjai naseīljai anga pikullai. En prūsiskamans pamīntlamans mazīngi aupaltun stawīdans fōrmins stesse wīrdas: <em>Pecols, Pocols, Pocclus, Poccolus, Picullus, Pykullas.</em> Tenesse wīds pastāi sendētan pa etwaidīnsnan stēisan krīkstjanan</p>\n<p>Kaddan en listei stēisan dēiwan ni ast papeisātan <a href="#Patals">Patals</a>, staddan papeisatāi <a href="#pikuls">Pikuls</a> be Pōkuls, stesse paggan mazīngi gadātun, kāi en pagaūsenju <a href="#Patals">Patals</a> be <a href="#pikuls">Pikuls</a> — Pōkuls bēi aīns dēiws stesse pazzemiskas swētas, lapīntajs stēisan aulaūwusin.</p>
